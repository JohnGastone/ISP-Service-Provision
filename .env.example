# Base URL of the Spring Boot backend. Server-side only — never exposed to the
# browser. The browser talks to /api/proxy/* on this Next app, which forwards
# here with the HTTP Basic credential attached. Because that hop is
# server-to-server, the backend needs no CORS configuration.
SPRING_API_URL=http://192.168.0.56:8080

# Cookie holding the base64 "user:pass" used for the API's HTTP Basic auth.
AUTH_COOKIE_NAME=isp_auth

# Set to "true" behind HTTPS so auth cookies are marked Secure.
COOKIE_SECURE=false

# How long to wait for the backend before failing fast (ms).
API_TIMEOUT_MS=6000

# The API restricts the pool list to admins, so the customer request form
# offers these pool ids instead. Comma-separated, e.g. "1,2,3".
CUSTOMER_POOL_IDS=1
