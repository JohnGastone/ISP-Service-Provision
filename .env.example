# Base URL of the Spring Boot backend. Server-side only — never exposed to the browser.
# The browser talks to /api/proxy/* on this Next app, which forwards here with the JWT attached.
SPRING_API_URL=http://localhost:8080

# Cookie name for the JWT issued by Spring Boot.
AUTH_COOKIE_NAME=isp_token

# Set to "true" behind HTTPS so auth cookies are marked Secure.
COOKIE_SECURE=false
